DATABASE_URL=file:./app.db

# AI: bedrock | openai-compatible
AI_PROVIDER=bedrock
# Model id for the chosen provider (bedrock uses an inference profile id)
AI_MODEL=us.anthropic.claude-sonnet-4-20250514-v1:0
# Optional: retried once if AI_MODEL fails or times out (AI_TIMEOUT_MS per attempt)
AI_FALLBACK_MODEL=
AI_TIMEOUT_MS=30000
# Embedding model id (only if you use vector search)
AI_EMBEDDING_MODEL=
# Only for openai-compatible (with AI_API_KEY)
AI_BASE_URL=
# Bedrock API key (bearer token) and region
AWS_BEARER_TOKEN_BEDROCK=
AWS_REGION=us-east-1
AI_API_KEY=

# Better Auth (optional, app runs without it)
ENABLE_AUTH=false
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
